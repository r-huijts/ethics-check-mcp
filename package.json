{
  "name": "@r-huijts/ethics-vibe-check",
  "version": "1.2.0",
  "description": "User-triggered MCP gut-check for bias, sycophancy, and conversation drift — with sessionTrend, swappable second-opinion models, and a companion Cursor skill.",
  "main": "build/index.js",
  "bin": {
    "ethics-vibe-check": "build/index.js",
    "ethics-vibe-check-install-skill": "scripts/install-skill.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "dev": "npm run build && node build/index.js",
    "start": "node build/index.js",
    "test": "node test-ethics.js",
    "test:storage": "node storage-analysis.js",
    "test:session": "npm run build && node tests/session-trend.test.js",
    "test:calibration": "npm run build && ETHICS_PROVIDER=mock node tests/calibration-eval.test.js",
    "test:calibration:live": "npm run build && node tests/calibration-eval.test.js",
    "test:all": "npm run build && npm run test:session && npm run test:calibration",
    "test:quick": "npm run build && echo 'Quick test: Build successful'",
    "install-skill": "node scripts/install-skill.js",
    "prepublishOnly": "npm run build",
    "generate-deeplink": "node generate-cursor-link.js"
  },
  "keywords": [
    "ai-ethics",
    "confirmation-bias",
    "sycophancy",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "critical-thinking",
    "bias-detection",
    "ollama"
  ],
  "author": "r-huijts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-huijts/ethics-check-mcp.git"
  },
  "homepage": "https://github.com/r-huijts/ethics-check-mcp#readme",
  "bugs": {
    "url": "https://github.com/r-huijts/ethics-check-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build/",
    "skills/",
    "scripts/install-skill.js",
    "evals/",
    "README.md",
    "USAGE.md",
    "LICENSE",
    "env.example",
    "docs/system-prompts.md",
    "generate-cursor-link.js"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
