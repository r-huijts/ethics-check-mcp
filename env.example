# Ethics Vibe Check MCP Server Configuration
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Optional: override where session drift history and learned concerns are stored.
# Defaults to ~/.ethics-vibe-check/data so memory survives across projects and
# MCP host launch directories (cwd is not a reliable storage root for npx servers).
# ETHICS_DATA_DIR=/absolute/path/to/your/ethics-data
